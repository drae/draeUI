<Ui xmlns='http://www.blizzard.com/wow/ui/'>
	<!--
		12.1: buttons are created by the AuraContainer and configured through
		its initializeFrame callback, so there is no OnLoad here and no size -
		InitAuraButton in init.lua does both.

		SecureActionButtonTemplate and the type2='cancelaura' attribute are
		gone with it. cancelaura needs an aura *index*, and index access errors
		once auras are secret; cancelling now goes through Blizzard's own
		untainted click handler, armed by SetCancelAuraButtons.
	-->
	<Button name='DraeUIAuraTemplate' inherits='CustomAuraButtonTemplate' virtual='true' framelevel='4'/>
	<!-- framelevel 4 for Masque support -->

	<!-- Oh, Look! A file we need to load -->
	<Script file='init.lua'/>
</Ui>
